# Required application secret. Generate a unique value for each environment.
# Production must not use this placeholder.
SECRET_KEY=replace-with-a-unique-secret
# Local development value. Production must explicitly set DEBUG=False.
DEBUG=True

# Comma-separated values. Production must explicitly list real hosts.
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Leave unset locally to use SQLite. Production must provide a valid PostgreSQL URL.
# DATABASE_URL=postgresql://user:password@host:5432/database

# Used for canonical URLs and generated enquiry links.
SITE_URL=http://localhost:8000
SITE_NAME=ProjectVybe
SITE_DESCRIPTION=ProjectVybe helps people build, learn, and grow through thoughtful technology projects and services.

# Optional integrations; do not commit real credentials.
WHATSAPP_NUMBER=
# CLOUDINARY_URL=cloudinary://your-api-key:your-api-secret@your-cloud-name
CLOUDINARY_URL=
# Optional public contact and sender values; configure production mail separately.
PUBLIC_CONTACT_EMAIL=support@projectvybe.com
# Sender shown to recipients. Use a verified-domain address with a display name.
DEFAULT_FROM_EMAIL=ProjectVybe Enquiries <notifications@projectvybe.com>
# In production, configure SMTP credentials for enquiry email delivery.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-smtp-user
# EMAIL_HOST_PASSWORD=your-smtp-password
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_TIMEOUT=10
# Send enquiry emails on a background thread (default: on in production, off in DEBUG).
# ENQUIRY_EMAIL_ASYNC=True

# Cloudflare Turnstile bot check on public forms. Leave both blank to disable.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Admin lockout: failed logins from one IP before it is blocked for an hour.
# AXES_FAILURE_LIMIT=5

# Admin path: use a private, hard-to-guess value in production, e.g. ADMIN_URL=ops-9f3k2/
ADMIN_URL=admin/

# Reverse proxies in front of the app (Render = 1; local development = 0).
# TRUSTED_PROXY_COUNT=1

# Abuse limits (requests per IP): enquiries per 10 minutes, searches per minute.
# ENQUIRY_RATE_LIMIT=5
# ENQUIRY_RATE_WINDOW=600
# SEARCH_RATE_LIMIT=60

# Database connection reuse in seconds (helps Neon) and admin session length.
# CONN_MAX_AGE=60
# SESSION_COOKIE_AGE=28800

# Production security flags.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
# Keep 0 locally. In production leave this unset (defaults to 31536000 = 1 year)
# once HTTPS works on both projectvybe.com and www.projectvybe.com.
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Razorpay (leave blank to keep online payment off). Use rzp_test_ keys until KYC is approved.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ORDERS_FROM_EMAIL=ProjectVybe Orders <orders@projectvybe.com>
