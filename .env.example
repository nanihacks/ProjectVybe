# Required application secret. Generate a unique value for each environment.
# Production must not use this placeholder.
SECRET_KEY=replace-with-a-unique-secret
# Local development value. Production must explicitly set DEBUG=False.
DEBUG=True

# Comma-separated values. Production must explicitly list real hosts.
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Leave unset locally to use SQLite. Production must provide a valid PostgreSQL URL.
# DATABASE_URL=postgresql://user:password@host:5432/database

# Used for canonical URLs and generated enquiry links.
SITE_URL=http://localhost:8000
SITE_NAME=ProjectVybe
SITE_DESCRIPTION=ProjectVybe helps people build, learn, and grow through thoughtful technology projects and services.

# Optional integrations; do not commit real credentials.
WHATSAPP_NUMBER=
# CLOUDINARY_URL=cloudinary://your-api-key:your-api-secret@your-cloud-name
CLOUDINARY_URL=
# Optional public contact and sender values; configure production mail separately.
PUBLIC_CONTACT_EMAIL=support@projectvybe.com
DEFAULT_FROM_EMAIL=support@projectvybe.com
# In production, configure SMTP credentials for enquiry email delivery.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-smtp-user
# EMAIL_HOST_PASSWORD=your-smtp-password
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_TIMEOUT=10

# Production security flags.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
